<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.oss.abraakadabraaapp">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIEW" />

            <data android:scheme="http" />
        </intent>
    </queries>
    <queries>
        <package android:name="com.whatsapp" />
    </queries>
    <queries>
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:killAfterRestore="false"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AbraaKaDabraa.App"
        android:usesCleartextTraffic="true"
        tools:ignore="HardcodedDebugMode,LockedOrientationActivity">
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="@string/google_api_key"/>

        <activity
            android:name=".activities.newflow.chat.ChatDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar"/>
        <activity
            android:name=".activities.newflow.TermsAndConditionsActivity"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".activities.newflow.RequesterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar"></activity>
        <activity
            android:name=".activities.SuccessActivity"
            android:exported="false" />
        <activity
            android:name=".activities.newflow.MyNotificationDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar" />
        <activity
            android:name=".activities.newflow.NewNotificationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar" />
        <activity
            android:name=".activities.newflow.MyNewProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar" />
        <activity
            android:name=".activities.newflow.ui.FeedbackActivity"
            android:exported="false"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar" />
        <activity
            android:name=".activities.newflow.TestActivity"
            android:exported="true" />
        <activity
            android:name=".activities.newflow.CategorySelectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar" />
        <activity
            android:name=".activities.newflow.ui.MyRequestDetailsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AbraaKaDabraa.NoActionBar" />
        <activity
            android:name=".activities.newflow.MyListingDetialActivity"
            android:exported="false"
