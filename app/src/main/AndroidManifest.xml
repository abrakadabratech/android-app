        <activity
            android:name=".activities.RequestProductDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.FilterActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.SearchActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.MyRequestActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.MultipleImageActivity"
