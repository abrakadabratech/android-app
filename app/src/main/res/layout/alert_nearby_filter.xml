<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="8dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHeight_percent="0.3"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_percent="0.8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="10dp"
            android:visibility="visible"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView37">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/latest_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_rect_shape"
                    android:elevation="20dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Latest"
                    android:textColor="@color/white"
                    android:textSize="@dimen/dp_17" />


                <TextView
                    android:id="@+id/nearest_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:elevation="20dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Nearest"
                    android:textColor="@color/hyper_link_text_color"
                    android:textSize="@dimen/dp_17" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView51"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="10dp"
            android:visibility="visible"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView56">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/all_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_rect_shape"
                    android:elevation="20dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="@dimen/dp_17" />

                <TextView
                    android:id="@+id/paid_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:elevation="20dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Paid"
                    android:textColor="@color/hyper_link_text_color"
                    android:textSize="@dimen/dp_17" />

                <TextView
                    android:id="@+id/free_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:elevation="20dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Free"
                    android:textColor="@color/hyper_link_text_color"
                    android:textSize="@dimen/dp_17" />


            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/applyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_bg_rounded_rect"
            android:fontFamily="@font/montserrat_semi_bold"
            android:gravity="center"
            android:paddingLeft="@dimen/dp_20"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/dp_20"
            android:paddingBottom="8dp"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView51" />

        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="@dimen/dp_16"
            android:layout_height="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_close_icon"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView117"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Filters products"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/closeBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nearToMeTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Nearest to me"
            android:textColor="@color/cat_select_color"
            android:textSize="@dimen/sp_16"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView117" />

        <TextView
            android:id="@+id/textView118"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F2F2F2"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/nearToMeSwitch"
            app:layout_constraintStart_toStartOf="@+id/nearToMeTxt"
            app:layout_constraintTop_toBottomOf="@+id/nearToMeTxt" />

        <TextView
            android:id="@+id/newrstFirstTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Newest First"
            android:textColor="@color/cat_unselect_color"
            android:textSize="@dimen/sp_16"

            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/nearToMeTxt"
            app:layout_constraintTop_toBottomOf="@+id/nearToMeTxt" />

        <TextView
            android:id="@+id/textView1181"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F2F2F2"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/newestFirstSwitch"
            app:layout_constraintStart_toStartOf="@+id/newrstFirstTxt"
            app:layout_constraintTop_toBottomOf="@+id/newrstFirstTxt" />

        <com.codersroute.flexiblewidgets.FlexibleSwitch
            android:id="@+id/nearToMeSwitch"
            android:layout_width="50dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginEnd="20dp"
            android:checked="true"
            android:visibility="gone"
            app:backgroundColorOnSwitchOff="#F0F0F8"
            app:backgroundColorOnSwitchOn="#00000029"
            app:layout_constraintBottom_toBottomOf="@+id/nearToMeTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/nearToMeTxt"
            app:showText="false"
            app:strokeColorOnSwitchOff="#ADB5BD"
            app:strokeColorOnSwitchOn="#3C8F7C"
            app:strokeWidth="2dp"
            app:textColorOnSwitchOff="#ADB5BD"
            app:textColorOnSwitchOn="#3C8F7C"
            app:thumbColorOnSwitchOff="#ADB5BD"
            app:thumbColorOnSwitchOn="#3C8F7C" />

        <com.codersroute.flexiblewidgets.FlexibleSwitch
            android:id="@+id/newestFirstSwitch"
            android:layout_width="50dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginEnd="20dp"
            android:checked="false"
            android:textSize="20sp"
            android:visibility="gone"
            app:backgroundColorOnSwitchOff="#F0F0F8"
            app:backgroundColorOnSwitchOn="#00000029"
            app:layout_constraintBottom_toBottomOf="@+id/newrstFirstTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/newrstFirstTxt"
            app:showText="false"
            app:strokeColorOnSwitchOff="#ADB5BD"
            app:strokeColorOnSwitchOn="#3C8F7C"
            app:strokeWidth="2dp"
            app:textColorOnSwitchOff="#ADB5BD"
            app:textColorOnSwitchOn="#3C8F7C"
            app:thumbColorOnSwitchOff="#ADB5BD"
            app:thumbColorOnSwitchOn="#3C8F7C" />

        <TextView
            android:id="@+id/textView30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Customize your product view by sorting and filtering"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/textView117"
            app:layout_constraintTop_toBottomOf="@+id/textView117" />

        <TextView
            android:id="@+id/textView37"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/montserrat_semi_bold"
            android:text="Sort By"
            app:layout_constraintStart_toStartOf="@+id/textView30"
            app:layout_constraintTop_toBottomOf="@+id/textView30" />

        <TextView
            android:id="@+id/textView56"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/montserrat_semi_bold"
            android:text="Filter By"
            app:layout_constraintStart_toStartOf="@+id/cardView5"
            app:layout_constraintTop_toBottomOf="@+id/cardView5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

