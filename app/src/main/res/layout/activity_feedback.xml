<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEFEFE"
    tools:context=".activities.newflow.ui.FeedbackActivity">

    <ImageView
        android:id="@+id/back_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back_arrow" />

    <TextView
        android:id="@+id/textView82"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="How was your experience ?"
        android:textColor="#1D2126"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_button"
        app:layout_constraintTop_toTopOf="@+id/back_button" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView82">

        <TextView
            android:id="@+id/headingOne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Did you get the product as \ndescribed?\n"
            android:textColor="@color/hyper_link_text_color"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView82" />

        <com.oss.abraakadabraaapp.activities.newflow.customeview.IndicatorSeekBar
            android:id="@+id/seekbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:isb_progress="30"
            app:isb_show_indicator="rectangle"
            app:isb_show_tick_marks_type="divider"
            app:isb_thumb_color="#FBFDFC"
            app:isb_thumb_size="20dp"
            app:isb_tick_marks_color="#FFFFFFFF"
            app:isb_ticks_count="6"
            app:isb_track_background_color="@color/isb_selector_tick_marks_color"
            app:isb_track_background_size="10dp"
            app:isb_track_progress_color="@color/isb_selector_tick_marks_color"
            app:isb_track_progress_size="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:text="Not at all"
                android:textColor="#8898AA"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="end"
                android:text="Absolutely"
                android:textColor="#8898AA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:id="@+id/headingTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Was the giver responsive to your \nrequest?\n"
            android:textColor="@color/hyper_link_text_color"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView82" />

        <com.oss.abraakadabraaapp.activities.newflow.customeview.IndicatorSeekBar
            android:id="@+id/seekbar1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:isb_progress="30"
            app:isb_show_indicator="rectangle"
            app:isb_show_tick_marks_type="divider"
            app:isb_thumb_color="#FBFDFC"
            app:isb_thumb_size="20dp"
            app:isb_tick_marks_color="#FFFFFFFF"
            app:isb_ticks_count="6"
            app:isb_track_background_color="@color/isb_selector_tick_marks_color"
            app:isb_track_background_size="10dp"
            app:isb_track_progress_color="@color/isb_selector_tick_marks_color"
            app:isb_track_progress_size="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:text="Not at all"
                android:textColor="#8898AA"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="end"
                android:text="Absolutely"
                android:textColor="#8898AA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

        <TextView
            android:id="@+id/headingThree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Was the product delivery convenient\nfor you?\n"
            android:textColor="@color/hyper_link_text_color"
            android:textSize="18sp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView82" />

        <com.oss.abraakadabraaapp.activities.newflow.customeview.IndicatorSeekBar
            android:id="@+id/seekbar2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:isb_progress="30"
            app:isb_show_indicator="rectangle"
            app:isb_show_tick_marks_type="divider"
            app:isb_thumb_color="#FBFDFC"
            app:isb_thumb_size="20dp"
            app:isb_tick_marks_color="#FFFFFFFF"
            app:isb_ticks_count="6"
            app:isb_track_background_color="@color/isb_selector_tick_marks_color"
            app:isb_track_background_size="10dp"
            app:isb_track_progress_color="@color/isb_selector_tick_marks_color"
            app:isb_track_progress_size="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:text="Not at all"
                android:textColor="#8898AA"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="end"
                android:text="Absolutely"
                android:textColor="#8898AA"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13">

        <EditText
            android:id="@+id/descriptionTxt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:gravity="top"
            android:text="djfajk"
            android:fontFamily="@font/montserrat_regular"
            android:background="@color/transparent"
            android:hint="Eg - Ladies Bag , bought it on my first foreign trip , in running condition.. \n\nGive close description of the item as possible to increase response"
            android:textColor="@color/edit_text_color"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textView13"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="16dp"
        android:text="Care to share more about it ?"
        android:textColor="#535C6B"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8" />
    <LinearLayout
        android:id="@+id/updateBtn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_bg_rounded_rect"
        android:gravity="center"
        android:visibility="visible"
        android:orientation="horizontal"
        android:padding="8dp"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Submit"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>