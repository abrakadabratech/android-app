<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEFEFE"
    tools:context=".activities.newflow.ui.FeedbackActivity">

    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back_arrow" />

    <TextView
        android:id="@+id/textView82"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="How was your experience ?"
        android:textColor="#1D2126"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView18"
        app:layout_constraintTop_toTopOf="@+id/imageView18" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView82">

        <TextView
            android:id="@+id/textView119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Did you get the product as \ndescribed?\n"
            android:textColor="@color/hyper_link_text_color"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView82" />

        <com.oss.abraakadabraaapp.activities.newflow.customeview.IndicatorSeekBar
            android:id="@+id/seekbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:isb_progress="30"
            app:isb_show_indicator="rectangle"
            app:isb_show_tick_marks_type="divider"
            app:isb_thumb_color="#FBFDFC"
            app:isb_thumb_size="20dp"
            app:isb_tick_marks_color="#FFFFFFFF"
            app:isb_ticks_count="6"
            app:isb_track_background_color="@color/isb_selector_tick_marks_color"
            app:isb_track_background_size="10dp"
            app:isb_track_progress_color="@color/isb_selector_tick_marks_color"
            app:isb_track_progress_size="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:text="Not at all"
                android:textColor="#8898AA"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="end"
                android:text="Absolutely"
                android:textColor="#8898AA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:id="@+id/textView1191"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Was the giver responsive to your \nrequest?\n"
            android:textColor="@color/hyper_link_text_color"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView82" />

        <com.oss.abraakadabraaapp.activities.newflow.customeview.IndicatorSeekBar
            android:id="@+id/seekbar1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:isb_progress="30"
            app:isb_show_indicator="rectangle"
            app:isb_show_tick_marks_type="divider"
            app:isb_thumb_color="#FBFDFC"
            app:isb_thumb_size="20dp"
            app:isb_tick_marks_color="#FFFFFFFF"
            app:isb_ticks_count="6"
            app:isb_track_background_color="@color/isb_selector_tick_marks_color"
            app:isb_track_background_size="10dp"
            app:isb_track_progress_color="@color/isb_selector_tick_marks_color"
            app:isb_track_progress_size="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:text="Not at all"
                android:textColor="#8898AA"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="end"
                android:text="Absolutely"
                android:textColor="#8898AA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

        <TextView
            android:id="@+id/textView1192"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Was the product delivery convenient\nfor you?\n"
            android:textColor="@color/hyper_link_text_color"
            android:textSize="18sp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView82" />

        <com.oss.abraakadabraaapp.activities.newflow.customeview.IndicatorSeekBar
            android:id="@+id/seekbar2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:isb_progress="30"
            app:isb_show_indicator="rectangle"
            app:isb_show_tick_marks_type="divider"
            app:isb_thumb_color="#FBFDFC"
            app:isb_thumb_size="20dp"
            app:isb_tick_marks_color="#FFFFFFFF"
            app:isb_ticks_count="6"
            app:isb_track_background_color="@color/isb_selector_tick_marks_color"
            app:isb_track_background_size="10dp"
            app:isb_track_progress_color="@color/isb_selector_tick_marks_color"
            app:isb_track_progress_size="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:text="Not at all"
                android:textColor="#8898AA"
                android:textSize="10sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="end"
                android:text="Absolutely"
                android:textColor="#8898AA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>