<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="328dp"
    android:layout_height="320dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="8dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHeight_percent="0.3"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_percent="0.8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView39"
            android:layout_width="@dimen/dp_16"
            android:layout_height="15dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="21dp"
            android:src="@drawable/ic_close_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/pay_anim"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_marginTop="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView117"
            app:layout_constraintWidth_percent="0.57"
            app:lottie_rawRes="@raw/flower_rupee" />

        <TextView
            android:id="@+id/textView117"
            android:layout_width="wrap_content"
            android:text="Report This Ad"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semi_bold"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="@+id/imageView39"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView39"
            app:layout_constraintTop_toTopOf="@+id/imageView39" />

        <TextView
            android:id="@+id/inAppropriateTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="17dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Inappropriate Content"
            android:textColor="@color/cat_select_color"
            android:textSize="@dimen/sp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pay_anim" />

        <TextView
            android:id="@+id/textView118"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F2F2F2"
            app:layout_constraintEnd_toEndOf="@+id/inAppropriateSwitch"
            app:layout_constraintStart_toStartOf="@+id/inAppropriateTxt"
            app:layout_constraintTop_toBottomOf="@+id/inAppropriateTxt" />

        <TextView
            android:id="@+id/fakeTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Spam / Fake ad"
            android:textColor="@color/cat_unselect_color"
            android:textSize="@dimen/sp_16"

            app:layout_constraintStart_toStartOf="@+id/inAppropriateTxt"
            app:layout_constraintTop_toBottomOf="@+id/inAppropriateTxt" />

        <TextView
            android:id="@+id/textView1181"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F2F2F2"
            app:layout_constraintEnd_toEndOf="@+id/fakeTxtSwitch"
            app:layout_constraintStart_toStartOf="@+id/fakeTxt"
            app:layout_constraintTop_toBottomOf="@+id/fakeTxt" />

        <ImageView
            android:id="@+id/inAppropriateSwitch"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginEnd="16dp"
            android:tag="1"
            android:background="@drawable/ic_radio_unselect"
            app:layout_constraintBottom_toBottomOf="@+id/inAppropriateTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/inAppropriateTxt" />


        <ImageView
            android:id="@+id/fakeTxtSwitch"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginEnd="16dp"
            android:tag="1"
            android:background="@drawable/ic_radio_unselect"
            app:layout_constraintBottom_toBottomOf="@+id/fakeTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/fakeTxt" />

        <TextView
            android:id="@+id/applyBtn"
            android:layout_width="111dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="33dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_bg_rounded_rect"
            android:fontFamily="@font/montserrat_semi_bold"
            android:gravity="center"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView1181" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

